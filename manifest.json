{
  "manifest_version": 3,
  "name": "Claude",
  "version": "2.0.10",
  "description": "Claude in the browser sidebar.",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "sidePanel",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://*.claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Claude",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "preconnect.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "claude-ui.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "claude-tidy.js",
        "claude-ui.css"
      ],
      "matches": [
        "https://claude.ai/*"
      ]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "frame",
        "enabled": true,
        "path": "rules.json"
      },
      {
        "id": "fetchmeta",
        "enabled": true,
        "path": "rules-fetch.json"
      }
    ]
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+C",
        "mac": "Alt+C"
      },
      "description": "Toggle Claude"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}
